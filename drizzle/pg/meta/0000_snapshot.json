        "txn_amount_positive": {
          "name": "txn_amount_positive",
          "value": "\"txn\".\"amount_minor\" > 0"
        },
        "txn_tips_non_negative": {
          "name": "txn_tips_non_negative",
          "value": "\"txn\".\"tips_minor\" >= 0"
        },
        "txn_fee_non_negative": {
          "name": "txn_fee_non_negative",
          "value": "\"txn\".\"fee_minor\" >= 0"
        },
        "txn_transfer_shape": {
          "name": "txn_transfer_shape",
          "value": "(\"txn\".\"type\" <> 'transfer') OR (\n        \"txn\".\"counter_account_id\" IS NOT NULL\n        AND \"txn\".\"counter_account_id\" <> \"txn\".\"account_id\"\n        AND \"txn\".\"category_id\" IS NULL\n        AND \"txn\".\"tips_minor\" = 0\n      )"
        },
        "txn_single_sided_shape": {
          "name": "txn_single_sided_shape",
          "value": "(\"txn\".\"type\" = 'transfer') OR (\n        \"txn\".\"counter_account_id\" IS NULL AND \"txn\".\"fee_minor\" = 0\n      )"
        },
        "txn_tips_on_expenses_only": {
          "name": "txn_tips_on_expenses_only",
          "value": "(\"txn\".\"type\" = 'expense') OR (\"txn\".\"tips_minor\" = 0)"
        }
      },
