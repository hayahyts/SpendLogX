{
  "expo": {
    "name": "SpendLogX",
    "slug": "spendlogx",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "spendlogx",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.spendlogx.app" },
    "android": { "package": "com.spendlogx.app", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": true }
  }
}
